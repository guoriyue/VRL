# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
.venv/
venv/
env/
!vrl/runtime/env/
!vrl/runtime/env/**
vrl/runtime/env/__pycache__/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Model weights and artifacts
*.pt
*.pth
*.safetensors
*.onnx
*.bin
# Exception: small pretrained reward MLP weights
!vrl/rewards/assets/*.pth

# Data
*.npy
*.npz
*.h5
*.hdf5
data/external/
data/cache/
datasets/**/images/
datasets/**/videos/
datasets/video_world/references/
!tests/fixtures/**

# Logs
*.log
logs/
/*_profile/

# OS
.DS_Store
Thumbs.db

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

outputs/
# Claude Code
.claude/

# Third-party submodules: track gitlinks via .gitmodules, ignore any
# stray content placed under third_party/ that isn't a tracked submodule.
third_party/*
!third_party/videophy
!third_party/joyai_echo
# Video reward / motion-eval benchmarks (no PyPI packaging; run via CLI or an
# external command — not imported by vrl/, so no *_packaging wrapper needed).
!third_party/PhyMotion
!third_party/VMBench
!third_party/DynamicEval
!third_party/CausVid
!third_party/MAGI-1
# Small audited MAGI prompt-token asset required at CLI import time. Model
# weights remain ignored; this one file is part of the pinned runtime source.
!third_party/MAGI-1/example/assets/special_tokens.npz
# Single editable-install wrapper exposing the un-packaged submodule sources as
# importable packages (so vrl/ needs no sys.path injection). Its generated
# *.egg-info stays ignored by the third_party/* rule. See third_party/README.md.
!third_party/pyproject.toml
!third_party/README.md

# All Python virtualenvs live under one parent dir (one ignore entry covers all)
.venvs/

# Model weights belong in the HF cache (~/.cache/huggingface), never the repo.
checkpoints/
