load("@pypi//:requirements.bzl", "all_requirements")
load("@pypi_vllm//:requirements.bzl", vllm_requirements = "all_requirements")
load("@rules_python//python:defs.bzl", "py_binary", "py_test")
load("//tools/python:defs.bzl", "vrl_library")

package(default_visibility = ["//visibility:public"])

exports_files(["pyproject.toml", "uv.lock"])

# The VRL package against the main uv.lock profile (model runtime + rewards).
# Hubs are generated from the lock, so nothing here repeats a version.
vrl_library(
    name = "vrl",
    requirements = all_requirements,
)

# The same sources against the vLLM stack (memory parking, paged attention).
vrl_library(
    name = "vrl_vllm",
    requirements = vllm_requirements,
)

# Shared-GPU topology: the model/reward stack plus vLLM's CuMem allocator for
# memory parking. Both hubs come from one uv.lock and every shared pin is
# identical, so this is the README's "vllm --no-deps overlay" made explicit.
vrl_library(
    name = "vrl_shared_gpu",
    requirements = all_requirements + vllm_requirements,
)

py_binary(
    name = "vrl_train",
    srcs = ["vrl/scripts/train.py"],
    main = "vrl/scripts/train.py",
    deps = [":vrl"],
)

# One-host supervisor: launches vrl.scripts.train (single process or
# torchrun DDP/FSDP ranks) with this target's own interpreter, restarts on
# retryable failure classes, and aggregates the per-rank verdict files.
py_binary(
    name = "vrl_supervise",
    srcs = ["vrl/scripts/supervise.py"],
    main = "vrl/scripts/supervise.py",
    deps = [":vrl"],
)

py_binary(
    name = "vrl_reward_service",
    srcs = ["vrl/rewards/service/server.py"],
    main = "vrl/rewards/service/server.py",
    deps = [":vrl"],
)

# Lint gates. They read sources from runfiles, so the tracked tree is data.
filegroup(
    name = "python_sources",
    srcs = glob(["vrl/**/*.py"]) + [
        "pyproject.toml",
        "//tests:python_sources",
        "//tools:python_sources",
    ],
)

py_test(
    name = "config_lint",
    size = "medium",
    srcs = ["vrl/config/lint.py"],
    main = "vrl/config/lint.py",
    env = {"CUDA_VISIBLE_DEVICES": ""},
    deps = [":vrl"],
)

py_test(
    name = "dead_flags",
    size = "medium",
    srcs = ["vrl/scripts/lint/dead_flags.py"],
    main = "vrl/scripts/lint/dead_flags.py",
    data = [":python_sources"],
    deps = [":vrl"],
)
