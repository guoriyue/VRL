module(name = "vrl", version = "0.1.0")

bazel_dep(name = "rules_python", version = "2.3.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12.13",
)
use_repo(python, "python_3_12_13_host")

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "toolchains_llvm", version = "1.9.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "19.1.7",
    stdlib = {"": "stdc++"},
    cxx_include_layout = {"linux-x86_64": "debian"},
)
sysroot = use_repo_rule("@toolchains_llvm//toolchain:sysroot.bzl", "sysroot")
sysroot(
    name = "linux_sysroot",
    sha256 = "84656a6df544ecef62169cfe3ab6e41bb4346a62d3ba2a045dc5a0a2ecea94a3",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/2202c161310ffde63729f29d27fe7bb24a0bc540/debian_stretch_amd64_sysroot.tar.xz"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@linux_sysroot//sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")
register_toolchains("@llvm_toolchain//:all")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_redist",
    version = "13.0.2",
    sha256 = "fce66717a81c510ffeb89ecc3e79849ab34af3b80139f750876d9033e31d71c2",
    components = ["cccl", "crt", "cudart", "culibos", "nvcc", "nvvm"],
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")
register_toolchains("@cuda//toolchain:nvcc-local-toolchain")

# Export the authoritative uv lock with a managed, checksummed tool.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "uv_export_tool",
    urls = ["https://github.com/astral-sh/uv/releases/download/0.10.2/uv-x86_64-unknown-linux-gnu.tar.gz"],
    sha256 = "6aa4576c31f791c0b9d4739e256d07358d45e7535695287fec03cf6839e25512",
    strip_prefix = "uv-x86_64-unknown-linux-gnu",
    build_file_content = 'exports_files(["uv"])',
)
# tokenizers 0.13.3 (pinned by VBench's transformers 4.33.2) ships no CPython 3.12
# wheel; build it from the locked sdist with a pinned Rust toolchain. The
# `invalid_reference_casting` lint is a hard error on rustc >= 1.73 and the
# 2023 sources trip it; it is allowed here, matching what the wheel's own
# release-era compiler did.
rust_wheel = use_repo_rule("//tools/dependencies:rust_wheel.bzl", "rust_wheel")
rust_wheel(
    name = "tokenizers_0_13_3_wheel",
    sdist_urls = ["https://files.pythonhosted.org/packages/29/9c/936ebad6dd963616189d6362f4c2c03a0314cf2a221ba15e48dd714d29cf/tokenizers-0.13.3.tar.gz"],
    sdist_sha256 = "2e546dbb68b623008a5442353137fbb0123d311a6d7ba52f2667c8862a75af2e",
    sdist_filename = "tokenizers-0.13.3.tar.gz",
    rust_urls = ["https://static.rust-lang.org/dist/rust-1.89.0-x86_64-unknown-linux-gnu.tar.xz"],
    rust_sha256 = "c4f2796b10ee886001f0799bc40caea38746403a33c379d77878c4f4683f9b51",
    rust_strip_prefix = "rust-1.89.0-x86_64-unknown-linux-gnu",
    rustflags = "-A invalid_reference_casting",
    interpreter = "@python_3_12_13_host//:python",
)

uv_exports = use_repo_rule("//tools/dependencies:uv_exports.bzl", "uv_exports")
uv_exports(
    name = "python_locks",
    project = "//:pyproject.toml",
    lock = "//:uv.lock",
    uv = "@uv_export_tool//:uv",
    interpreter = "@python_3_12_13_host//:python",
    built_wheels = {"tokenizers": "@tokenizers_0_13_3_wheel"},
    profiles = {
        # Every extra pyproject.toml lets compose in one environment, plus the
        # test and lint groups, so one hub serves libraries, tests and lint
        # without duplicate package copies. Conflicting extras get their own hub.
        "main": [
            "--extra", "cosmos", "--extra", "reward", "--extra", "reward-service",
            "--extra", "data", "--extra", "ocr", "--extra", "detection",
            "--extra", "optim8bit", "--group", "test", "--group", "lint",
        ],
        # Conflicting stacks each carry the test group so their lanes need no
        # second hub for pytest.
        "vllm": ["--extra", "ar-vllm", "--group", "test"],
        "videoeval": ["--extra", "videoeval", "--group", "test"],
    },
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "vrl_pypi",
    python_version = "3.12.13",
    requirements_lock = "@python_locks//:main.txt",
    target_platforms = ["linux_x86_64"],
)

# Dependency sets pyproject.toml declares as conflicting with the main stack.
# Each is its own hub from the same uv.lock; a target picks exactly one.
pip.parse(
    hub_name = "vrl_pypi_vllm",
    python_version = "3.12.13",
    requirements_lock = "@python_locks//:vllm.txt",
    target_platforms = ["linux_x86_64"],
)
pip.parse(
    hub_name = "vrl_pypi_videoeval",
    python_version = "3.12.13",
    requirements_lock = "@python_locks//:videoeval.txt",
    target_platforms = ["linux_x86_64"],
)
use_repo(pip, "vrl_pypi", "vrl_pypi_videoeval", "vrl_pypi_vllm")

# MAGI-1's official stack (torch 2.4.0/cu124, transformers 4.42.3, flashinfer)
# from third_party/magi_1/requirements.txt, with flash-attn 2.4.2 built from
# its locked sdist against that exact torch by a pinned CUDA 12.4.1 nvcc.
# flash-attn 2.4.2 emits sm_80/sm_90 SASS only: it runs on Ampere/Ada/Hopper
# hosts, not on Blackwell.
cuda_wheel = use_repo_rule("//tools/dependencies:cuda_wheel.bzl", "cuda_wheel")
cuda_wheel(
    name = "flash_attn_2_4_2_wheel",
    sdist_urls = ["https://files.pythonhosted.org/packages/4e/2f/a8d5495cd020e70474095107f0519a11fdff81a2a6cc15755feb1e19b027/flash_attn-2.4.2.tar.gz"],
    sdist_sha256 = "eb822a8c4219b610e9d734cbc8cd9ee4547f27433815a2b90dc1462766feefc1",
    sdist_filename = "flash_attn-2.4.2.tar.gz",
    cuda_components = {
        "nvcc": "https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvcc/linux-x86_64/cuda_nvcc-linux-x86_64-12.4.131-archive.tar.xz 7ffba1ada0e4b8c17e451ac7a60d386aa2642ecd08d71202a0b100c98bd74681",
        "cudart": "https://developer.download.nvidia.com/compute/cuda/redist/cuda_cudart/linux-x86_64/cuda_cudart-linux-x86_64-12.4.127-archive.tar.xz 0483bff9a36e7a44465db3cd42874f6f70f019297dcf803fbefcbf58d7448c8f",
        "cccl": "https://developer.download.nvidia.com/compute/cuda/redist/cuda_cccl/linux-x86_64/cuda_cccl-linux-x86_64-12.4.127-archive.tar.xz e1636f27a142d24e73dfd831c54bbf5575b498fd5900648d7372fae46f824fdf",
        # torch's ATen/cuda headers include the math-library headers.
        "cublas": "https://developer.download.nvidia.com/compute/cuda/redist/libcublas/linux-x86_64/libcublas-linux-x86_64-12.4.5.8-archive.tar.xz c267c4d2cd42065ae2c30ca41a43ddce4e0ecc5484de23f299e3c397b5506eda",
        "cusparse": "https://developer.download.nvidia.com/compute/cuda/redist/libcusparse/linux-x86_64/libcusparse-linux-x86_64-12.3.1.170-archive.tar.xz 21b7e5c3afd8c3e761471c644b8bbf36cd528dd0f9d274becbeb09b79dd9bec5",
        "cufft": "https://developer.download.nvidia.com/compute/cuda/redist/libcufft/linux-x86_64/libcufft-linux-x86_64-11.2.1.3-archive.tar.xz 0963b4b57fb7fe9217e97b494159ff4719f1abdc407b2dc215d71bae0576bb02",
        "curand": "https://developer.download.nvidia.com/compute/cuda/redist/libcurand/linux-x86_64/libcurand-linux-x86_64-10.3.5.147-archive.tar.xz f3752abef1ffae7bc9180bd9885905e971cc9c28d7f4d5860731a012e07638a3",
        "cusolver": "https://developer.download.nvidia.com/compute/cuda/redist/libcusolver/linux-x86_64/libcusolver-linux-x86_64-11.6.1.9-archive.tar.xz 0a35a16e3bc02ba6fe0393e916da087bac079eb998a01666c79533db4f0d37f6",
        "nvrtc": "https://developer.download.nvidia.com/compute/cuda/redist/cuda_nvrtc/linux-x86_64/cuda_nvrtc-linux-x86_64-12.4.127-archive.tar.xz b5e7a984fcf05d3123684d7926e595306d31fbf99f9b19e9a0d268a02fc75827",
        "cupti": "https://developer.download.nvidia.com/compute/cuda/redist/cuda_cupti/linux-x86_64/cuda_cupti-linux-x86_64-12.4.127-archive.tar.xz 232f4677a30335f4bafcd4a42b61d4cb65060680067e0dce32966d663f4224ac",
        "profiler_api": "https://developer.download.nvidia.com/compute/cuda/redist/cuda_profiler_api/linux-x86_64/cuda_profiler_api-linux-x86_64-12.4.127-archive.tar.xz fa11c08e39ab35453e07dd5012adc0767408955431fc4acdf64ca4cdd7692646",
    },
    requirements = "//third_party/magi_1:requirements.txt",
    build_requirements = ["ninja==1.11.1.1", "packaging==24.2", "setuptools==75.8.0", "wheel==0.45.1"],
    max_jobs = "8",
    interpreter = "@python_3_12_13_host//:python",
)

magi_1_requirements = use_repo_rule("//tools/dependencies:uv_exports.bzl", "requirements_with_built_wheels")
magi_1_requirements(
    name = "magi_1_locks",
    requirements = "//third_party/magi_1:requirements.txt",
    interpreter = "@python_3_12_13_host//:python",
    built_wheels = {"flash-attn": "@flash_attn_2_4_2_wheel"},
)

pip.parse(
    hub_name = "vrl_pypi_magi_1",
    python_version = "3.12.13",
    requirements_lock = "@magi_1_locks//:requirements.txt",
    target_platforms = ["linux_x86_64"],
)
use_repo(pip, "vrl_pypi_magi_1")
