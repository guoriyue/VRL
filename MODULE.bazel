module(name = "vrl", version = "0.1.0")

bazel_dep(name = "rules_python", version = "2.3.3")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12.13",
)
use_repo(python, "python_3_12_13_host")

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "toolchains_llvm", version = "1.9.0")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "19.1.7",
    stdlib = {"": "stdc++"},
    cxx_include_layout = {"linux-x86_64": "debian"},
)
sysroot = use_repo_rule("@toolchains_llvm//toolchain:sysroot.bzl", "sysroot")
sysroot(
    name = "linux_sysroot",
    sha256 = "84656a6df544ecef62169cfe3ab6e41bb4346a62d3ba2a045dc5a0a2ecea94a3",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/2202c161310ffde63729f29d27fe7bb24a0bc540/debian_stretch_amd64_sysroot.tar.xz"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@linux_sysroot//sysroot",
    targets = ["linux-x86_64"],
)
use_repo(llvm, "llvm_toolchain")
register_toolchains("@llvm_toolchain//:all")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_redist",
    version = "13.0.2",
    sha256 = "fce66717a81c510ffeb89ecc3e79849ab34af3b80139f750876d9033e31d71c2",
    components = ["cccl", "crt", "cudart", "culibos", "nvcc", "nvvm"],
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")
register_toolchains("@cuda//toolchain:nvcc-local-toolchain")

# Export the authoritative uv lock with a managed, checksummed tool.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "uv_export_tool",
    urls = ["https://github.com/astral-sh/uv/releases/download/0.10.2/uv-x86_64-unknown-linux-gnu.tar.gz"],
    sha256 = "6aa4576c31f791c0b9d4739e256d07358d45e7535695287fec03cf6839e25512",
    strip_prefix = "uv-x86_64-unknown-linux-gnu",
    build_file_content = 'exports_files(["uv"])',
)
uv_exports = use_repo_rule("//tools/dependencies:uv_exports.bzl", "uv_exports")
uv_exports(
    name = "python_locks",
    project = "//:pyproject.toml",
    lock = "//:uv.lock",
    uv = "@uv_export_tool//:uv",
    interpreter = "@python_3_12_13_host//:python",
    profiles = {
        # Every extra pyproject.toml lets compose in one environment, plus the
        # test and lint groups, so one hub serves libraries, tests and lint
        # without duplicate package copies. Conflicting extras get their own hub.
        "main": [
            "--extra", "cosmos", "--extra", "reward", "--extra", "reward-service",
            "--extra", "data", "--extra", "ocr", "--extra", "detection",
            "--extra", "optim8bit", "--extra", "janus", "--group", "test", "--group", "lint",
        ],
        # Conflicting stacks each carry the test group so their lanes need no
        # second hub for pytest.
        "vllm": ["--extra", "ar-vllm", "--group", "test"],
    },
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "vrl_pypi",
    python_version = "3.12.13",
    requirements_lock = "@python_locks//:main.txt",
    target_platforms = ["linux_x86_64"],
)

# Dependency sets pyproject.toml declares as conflicting with the main stack.
# Each is its own hub from the same uv.lock; a target picks exactly one.
pip.parse(
    hub_name = "vrl_pypi_vllm",
    python_version = "3.12.13",
    requirements_lock = "@python_locks//:vllm.txt",
    target_platforms = ["linux_x86_64"],
)
# Not a hub yet: the videoeval extra (VBench 0.1.5 -> transformers 4.33.2 ->
# tokenizers 0.13.3) ships no CPython 3.12 wheel and would need a Rust source
# build; see docs/research/bazel_migration.md.
use_repo(pip, "vrl_pypi", "vrl_pypi_vllm")

# CountGD reward: pinned upstream source (with the qualified torch-2 patch),
# the Hugging Face Space assets, and its own dependency hub. These fetch only
# when a //third_party/countgd target is built.
COUNTGD_SOURCE_REVISION = "b6f362b3f5cd20db4a171faa410dfed8f2f466d8"
COUNTGD_SPACE_REVISION = "6e82e59569a84ee5c6aafa35d396f2d2bee57be2"
COUNTGD_SPACE_URL = "https://huggingface.co/spaces/nikigoli/countgd/resolve/" + COUNTGD_SPACE_REVISION + "/"

http_archive(
    name = "countgd_src",
    urls = ["https://codeload.github.com/niki-amini-naieni/CountGD/tar.gz/" + COUNTGD_SOURCE_REVISION],
    sha256 = "dcab136e4c1ce9a567a3f67bef084ec3efbcbe15c6f6155755fea4ac48457378",
    strip_prefix = "CountGD-" + COUNTGD_SOURCE_REVISION,
    type = "tar.gz",
    patches = ["//third_party/countgd:ms_deform_attn_torch2.patch"],
    patch_args = ["-p1"],
    build_file_content = 'filegroup(name = "all_files", srcs = glob(["**"]), visibility = ["//visibility:public"])',
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

[
    http_file(
        name = "countgd_space_" + name,
        urls = [COUNTGD_SPACE_URL + path],
        sha256 = sha256,
        downloaded_file_path = path.rpartition("/")[2],
    )
    for name, path, sha256 in [
        ("cfg_app", "cfg_app.py", "b7e7061e8f343f054adff6b9417a6acd4e7c155e767c22cf58f533c8d8fd0587"),
        ("checkpoint", "checkpoint_best_regular.pth", "c1bab864b17db345b4c6e3aaabb5765bc2c0a90d0bc8defb5e664a74a50aa126"),
        ("bert_config", "checkpoints/bert-base-uncased/config.json", "f2375bb637ff0932102389231414227f0517017a8b8d724d084d9229fd5966e1"),
        ("bert_model", "checkpoints/bert-base-uncased/model.safetensors", "5875f83030335d194f35b15a32e7f4e654aa302aa83af032a3f36d035dcaf8af"),
        ("bert_special_tokens_map", "checkpoints/bert-base-uncased/special_tokens_map.json", "b6d346be366a7d1d48332dbc9fdf3bf8960b5d879522b7799ddba59e76237ee3"),
        ("bert_tokenizer", "checkpoints/bert-base-uncased/tokenizer.json", "d241a60d5e8f04cc1b2b3e9ef7a4921b27bf526d9f6050ab90f9267a1f9e5c66"),
        ("bert_tokenizer_config", "checkpoints/bert-base-uncased/tokenizer_config.json", "f62a57a75856b93282501c92a86f62b169997c81e93cf6f75b7cc15d6285968e"),
        ("bert_vocab", "checkpoints/bert-base-uncased/vocab.txt", "07eced375cec144d27c900241f3e339478dec958f92fddbc551f295c992038a3"),
    ]
]

pip.parse(
    hub_name = "vrl_pypi_countgd",
    python_version = "3.12.13",
    requirements_lock = "//third_party/countgd:requirements.txt",
    target_platforms = ["linux_x86_64"],
)
use_repo(pip, "vrl_pypi_countgd")

# Janus-Pro model code (deepseek-ai/Janus ships no PyPI package). Pinned commit,
# patched so its PretrainedConfig subclasses survive transformers 5's dataclass
# conversion; runtime dependencies come from the `janus` extra in uv.lock.
http_archive(
    name = "janus_src",
    urls = ["https://codeload.github.com/deepseek-ai/Janus/tar.gz/1daa72fa409002d40931bd7b36a9280362469ead"],
    sha256 = "3725fde8817c50ad61828401c598a2a7ee314c8b7d211920c593b1a667f3813c",
    strip_prefix = "Janus-1daa72fa409002d40931bd7b36a9280362469ead",
    type = "tar.gz",
    patches = ["//third_party/janus:transformers5_dataclass_defaults.patch"],
    patch_args = ["-p1"],
    build_file_content = """
load("@rules_python//python:defs.bzl", "py_library")
py_library(
    name = "janus",
    srcs = glob(["janus/**/*.py"]),
    imports = ["."],
    visibility = ["//visibility:public"],
)
""",
)
