load("@rules_python//python:defs.bzl", "py_test")

py_test(
    name = "python_toolchain_test",
    srcs = ["python_toolchain_test.py"],
    deps = ["//:vrl"],
)

# Real-GPU check that the pinned torch wheel and its NVIDIA runtime libraries
# come from the lock, not from a developer venv or a system CUDA install.
py_test(
    name = "torch_cuda_test",
    srcs = ["torch_cuda_test.py"],
    deps = [
        "//tools/python:nvidia_preload",
        "@vrl_pypi//torch",
    ],
    tags = ["gpu", "manual", "no-remote"],
)

# A real two-rank torchrun launch from the Bazel interpreter: every rank
# resolves vrl and its dependencies from runfiles, not from a venv.
py_test(
    name = "torchrun_test",
    size = "medium",
    srcs = [
        "torchrun_rank.py",
        "torchrun_test.py",
        "__init__.py",
        "//tests:__init__.py",
    ],
    main = "torchrun_test.py",
    deps = ["//:vrl"],
)
