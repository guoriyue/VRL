load("@rules_python//python:defs.bzl", "py_library")
load("//tools/pytest:defs.bzl", "vrl_pytest")

package(default_visibility = ["//visibility:public"])

exports_files(["__init__.py"])

filegroup(
    name = "python_sources",
    srcs = glob(["**/*.py"]),
)

# Every test module and fixture. Test packages import each other's fixtures
# and even test modules (tests.config.test_load_all_experiments), so each
# lane carries the whole tree and runs only the files it is given. One
# support library per dependency hub.
TEST_TREE = glob(
    ["**/*.py"],
    exclude = [
        "build/**",
        "toolchains/**",
    ],
)

TEST_FIXTURE_FILES = glob(["**/fixtures/**"], exclude = ["**/*.py"], allow_empty = True)

py_library(
    name = "support",
    srcs = TEST_TREE,
    data = TEST_FIXTURE_FILES,
    deps = ["//:vrl"],
)

py_library(
    name = "support_vllm",
    srcs = TEST_TREE,
    data = TEST_FIXTURE_FILES,
    deps = ["//:vrl_vllm"],
)

py_library(
    name = "support_shared_gpu",
    srcs = TEST_TREE,
    data = TEST_FIXTURE_FILES,
    deps = ["//:vrl_shared_gpu"],
)

# CPU lanes mirror `make verify`: the CUDA mask keeps optional GPU tests from
# borrowing a developer GPU just because one is visible.
CPU_ENV = {"CUDA_VISIBLE_DEVICES": ""}

NOT_SLOW = ["-m", "'not e2e and not slow_test'"]

vrl_pytest(
    name = "config_tests",
    size = "large",
    srcs = glob(["config/**/*.py"]),
    data = ["//manifests:manifests"],
    env = CPU_ENV,
)

vrl_pytest(
    name = "root_tests",
    size = "medium",
    srcs = ["test_logging.py", "test_runtime_errors.py"],
    env = CPU_ENV,
)

# One lane per top-level test package. `srcs` globs conftest/helpers too, so
# package-local fixtures stay importable.
[
    vrl_pytest(
        name = lane + "_tests",
        size = "enormous",
        srcs = glob([lane + "/**/*.py"]),
        args = NOT_SLOW,
        data = ["//manifests:manifests"] + extra_data,
        env = CPU_ENV,
    )
    for lane, extra_data in [
        ("algorithms", []),
        ("data", []),
        ("generation", []),
        ("math", []),
        ("models", []),
        ("nn", []),
        ("ray", []),
        ("rewards", []),
        ("rollouts", []),
        ("scripts", []),
        ("trainers", []),
        ("trajectory", []),
        ("utils", []),
    ]
]

# Real-GPU lanes: opt in with `bazel test --config=gpu`; they need a visible
# NVIDIA device and run the `gpu` marker only. The vLLM lane exercises CuMem
# memory parking from the isolated vLLM stack.
GPU_TAGS = ["gpu", "manual", "no-remote", "exclusive"]

vrl_pytest(
    name = "gpu_tests",
    size = "enormous",
    srcs = TEST_TREE,
    args = ["-m", "'gpu and not e2e and not slow_test'"],
    data = ["//manifests:manifests"],
    tags = GPU_TAGS,
)

vrl_pytest(
    name = "gpu_vllm_tests",
    size = "enormous",
    srcs = glob([
        "utils/**/*.py",
        "generation/execution/**/*.py",
        "nn/**/*.py",
    ]),
    args = ["-m", "gpu"],
    support = ":support_vllm",
    tags = GPU_TAGS,
)

# Real-weight end-to-end RL steps (one rollout + one optimizer update per
# model family) against checkpoints the operator already has in the Hugging
# Face cache. Weights are the operator's choice, not build inputs: pass
# `--test_env=HF_HOME=...` and select cases with WM_REAL_MODEL_RL_CASES.
#   bazel test --config=gpu --config=real_weights //tests:e2e_real_checkpoint_tests
vrl_pytest(
    name = "e2e_real_checkpoint_tests",
    size = "enormous",
    timeout = "eternal",
    srcs = glob(["e2e/**/*.py"]),
    args = ["-m", "e2e"],
    data = ["//manifests:manifests"],
    env = {"WM_RUN_REAL_MODEL_TESTS": "1"},
    support = ":support_shared_gpu",
    tags = GPU_TAGS + ["external"],
)

# Local Ray cluster smoke tests: real raylet + actors started from the
# Bazel-managed interpreter, so rollout workers resolve the same closure.
vrl_pytest(
    name = "ray_slow_tests",
    size = "enormous",
    srcs = glob(["ray/**/*.py", "generation/ray/**/*.py", "rollouts/**/*.py"]),
    args = ["-m", "'slow_test and not e2e'"],
    data = ["//manifests:manifests"],
    env = CPU_ENV,
    tags = ["exclusive"],
)
