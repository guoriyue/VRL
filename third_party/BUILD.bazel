load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

# The vendored submodules that third_party/pyproject.toml exposes as importable
# packages. `imports` replaces that editable install: each entry is one
# submodule's un-packaged source root, exactly the `where` list there.
py_library(
    name = "vendored",
    srcs = glob(
        [
            "videophy/videocon/training/pipeline_video/mplug_owl_video/**/*.py",
            "vdn-minimax-h3/src/**/*.py",
        ],
        allow_empty = True,
    ),
    data = glob(
        [
            "vdn-minimax-h3/src/**/*.yaml",
            "vdn-minimax-h3/src/**/*.json",
        ],
        allow_empty = True,
    ),
    imports = [
        "videophy/videocon/training/pipeline_video",
        "vdn-minimax-h3",
    ],
)

